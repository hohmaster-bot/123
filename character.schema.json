{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wipefinder.local/schema/character.v1.json",
  "title": "WIPEFINDER Character",
  "description": "Схема файла персонажа. Версия схемы — в поле _schema_version. Ключи, начинающиеся с '_', вычисляемые/GUI-only, не редактируются вручную.",
  "type": "object",
  "version": 1,

  "required": [
    "name", "class_display", "abilities", "ability_damage",
    "combat", "items", "attacks", "settings"
  ],

  "properties": {

    "_schema_version": {
      "type": "integer", "const": 2,
      "description": "Версия этой схемы. Сверять при миграциях. v2: show_portrait → hide_portrait (инверсия смысла)."
    },

    "name":            { "type": "string", "minLength": 1 },
    "class_display":   { "type": "string", "minLength": 1 },

    "hp":            { "type": "string", "pattern": "^\\d+\\/\\d+$", "description": "LEGACY display-only. Источник правды: combat.hp_current + _hp_max_cap." },
    "pain_threshold":{ "type": "string", "pattern": "^\\d+\\/\\d+$", "description": "LEGACY display-only. Источник: _pain_threshold_data." },
    "balance":       { "type": "string", "pattern": "^\\d+\\/\\d+$", "description": "LEGACY display-only. Источник: _balance_data." },
    "spirit":        { "type": "string", "pattern": "^\\d+\\/\\d+$", "description": "LEGACY display-only. Источник: _spirit_data." },
    "mana":          { "type": "string", "pattern": "^\\d+\\/\\d+$", "description": "LEGACY display-only. Источник: _mana_data.current/max." },
    "ac":            { "type": "integer", "description": "LEGACY display-only. Источник: combat.ac." },
    "parrying":      { "type": "integer", "description": "Парирование. Отдельное поле (не алиас combat.cmd). Источник правды для AC (парирование)." },    "bab":           { "type": "integer", "description": "LEGACY display-only. Источник: combat.bab." },

    "injury_points": { "type": "integer", "minimum": 0 },
    "morale":        { "type": "integer" },
    "ignore_pain":            { "type": "boolean" },
    "ignore_negative_morale": { "type": "boolean" },
    "overload":         { "type": "integer", "minimum": 0 },
    "overload_enabled": { "type": "boolean" },
    "auto_balance_on_tick": { "type": "boolean" },

    "save_fort": { "type": "integer", "description": "LEGACY display-only. Источник: combat.saves.fort." },
    "save_ref":  { "type": "integer", "description": "LEGACY display-only. Источник: combat.saves.ref." },
    "save_will": { "type": "integer", "description": "LEGACY display-only. Источник: combat.saves.will." },

    "xp":           { "type": "integer", "minimum": 0 },
    "xp_threshold": { "type": "integer", "minimum": 1 },

    "portrait":     { "type": "string" },
    "portrait_b64": { "type": "string" },
    "background_image": { "type": "string" },
    "background_b64":   { "type": "string" },
    "music_url":    { "type": "string" },

    "situational_bonuses": {
      "type": "array",
      "description": "Бафы/дебафы. Эффекты — либо постоянные (effects[]), либо разовые при активации (on_activate_effects[]). value может быть числом или формулой ('2*lvl', 'd4+1', 'con_mod').",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name":             { "type": "string" },
          "desc":             { "type": "string" },
          "duration_rounds":  { "type": "integer", "minimum": 0 },
          "duration_current": { "type": "integer", "minimum": 0 },
          "charges_max":      { "type": "integer", "minimum": 0 },
          "charges_current":  { "type": "integer", "minimum": 0 },
          "tick_on_initiative": { "type": "boolean" },
          "charges_tick_mode": {
            "type": "string",
            "enum": ["none", "decrement", "increment"],
            "default": "none",
            "description": "T34.1: тик зарядов на инициативе. none = не тикают, decrement = -1, increment = +1."
          },
          "effects": {
            "type": "array",
            "items": { "$ref": "#/$defs/Effect" },
            "description": "Постоянные эффекты бафа. См. $defs.Effect (value: число|формула, bonus_type)."
          },
          "blocks": {
  "type": "array",
  "items": { "type": "string" },
  "description": "T-BLOCKS-EXPANDED (v18.5): запреты. Префиксы: do:* (действия, напр. do:balance_restore), deny:* (запрет бонусов к целям: deny:ac, deny:attack, deny:skill), res:* (запрет восстановления: res:restore_hp, res:restore_mana)."
},
          "permanent":    { "type": "boolean", "default": true,
            "description": "Вечный баф: без +/- и без тика, удаляется только крестиком." },
          "keep_at_zero": { "type": "boolean", "default": true,
            "description": "Не удалять автоматически при duration_current == 0 на след. тике." },
          "allow_toggle": { "type": "boolean", "default": true,
            "description": "T-EFFECTS-UI: кнопка ON/OFF в чипе." },
          "enabled": { "type": "boolean", "default": true,
            "description": "T-EFFECTS-UI: эффект активен (если allow_toggle)." }
        }
      }
    },

    "char_class": { "$ref": "#/$defs/ClassDef" },
    "race":       { "$ref": "#/$defs/RaceDef" },

    "abilities": {
      "type": "object",
      "required": ["str","dex","con","int","wis","cha"],
      "properties": {
        "str": { "type": "integer" }, "dex": { "type": "integer" },
        "con": { "type": "integer" }, "int": { "type": "integer" },
        "wis": { "type": "integer" }, "cha": { "type": "integer" }
      }
    },

    "ability_damage": {
      "type": "object",
      "description": "Штраф/урон по характеристикам (не путать с abilities).",
      "properties": {
        "str": { "type": "integer" }, "dex": { "type": "integer" },
        "con": { "type": "integer" }, "int": { "type": "integer" },
        "wis": { "type": "integer" }, "cha": { "type": "integer" }
      }
    },

    "combat": { "$ref": "#/$defs/Combat" },
    "equipment": { "$ref": "#/$defs/Equipment" },

    "natural_armor": { "type": "integer" },
    "ac_bonus":      { "type": "integer" },
    "ac_misc":       { "type": "integer" },

    "cmb_mods": { "type": "array", "items": { "$ref": "#/$defs/Mod" } },
    "cmd_mods": { "type": "array", "items": { "$ref": "#/$defs/Mod" } },

    "items": {
      "type": "object",
      "description": "Словарь UUID -> Item. Ключ обязан совпадать с item.id.",
      "additionalProperties": { "$ref": "#/$defs/Item" }
    },

    "attacks":  { "type": "array", "items": { "$ref": "#/$defs/Attack" } },
    "spells":   { "type": "array", "items": { "$ref": "#/$defs/Spell" } },
    "spell_slots": { "type": "object", "additionalProperties": { "type": "integer" } },
    "spell_slots_enabled": { "type": "boolean" },
    "class_resources": { "type": "array", "items": { "type": "object" } },

    "proficiencies": { "$ref": "#/$defs/Proficiencies" },
    "armor_invested":  { "type": "integer", "minimum": 0 },
    "shield_invested": { "type": "integer", "minimum": 0 },

    "training": { "$ref": "#/$defs/Training" },
    "skills":   { "type": "array", "items": { "$ref": "#/$defs/Skill" } },
    "feats":    { "type": "array", "items": { "$ref": "#/$defs/Feat" } },
    "quirks":   { "type": "array", "items": { "$ref": "#/$defs/Quirk" } },
    "languages":{ "type": "array", "items": { "$ref": "#/$defs/Language" } },
    "templates":{ "type": "array", "items": { "type": "object" } },
    "wiki_links": { "type": "array", "items": { "type": "object" } },
    "lenses": {
      "type": "array",
      "items": { "$ref": "#/$defs/Lens" }
    },

    "drives": {
      "type": "object",
      "properties": {
        "idealism": { "type": "integer" }, "growth": { "type": "integer" },
        "knowledge":{ "type": "integer" }, "autonomy": { "type": "integer" },
        "pleasure": { "type": "integer" }, "material": { "type": "integer" },
        "triumph":  { "type": "integer" }, "success":  { "type": "integer" },
        "society":  { "type": "integer" }, "decadence":{ "type": "integer" }
      }
    },
    "drive_principles": { "type": "array", "items": { "type": "object" } },
    "courts":       { "type": "array", "items": { "type": "object" } },
    "court_quests": { "type": "array", "items": { "type": "object" } },
    "seeds":        { "type": "array", "items": { "type": "object" } },

    "downtime": { "$ref": "#/$defs/Downtime" },

    "bag_dropped": { "type": "boolean" },
    "injuries":    { "type": "array", "items": { "$ref": "#/$defs/Injury" } },
    "reactions":         { "type": "integer", "minimum": 0 },
    "reactions_invested":{ "type": "integer", "minimum": 0 },

    "active_stance": { "type": ["string","null"], "default": null,
      "description": "T-STANCE: имя активной стойки (FK на feats[].name, is_stance=true) или null = «Обычная». Меняется сколько угодно, не тикает." },

    "action_log": {
      "type": "array",
      "maxItems": 20,
      "description": "T-LOG: журнал трат (append-only, 20 последних). Только расход. Реверс — через before/after.",
      "items": {
        "type": "object",
        "required": ["ts","kind","summary"],
        "properties": {
          "ts":      { "type": "string" },
          "kind":    { "type": "string", "enum": ["hp","balance","spirit","mana","slot","charge","ability","stat","training","spell","item","buff","initiative_tick","other"] },
          "summary": { "type": "string" },
          "before":  { "type": "object" },
          "after":   { "type": "object" },
          "rev":     { "type": "boolean", "default": true }
        }
      }
    },
    
    "parry_ranged_current": { "type": "integer", "minimum": 0 },
    "parry_ranged_max":     { "type": "integer", "minimum": 0 },
    "master_reroll_current": { "type": "integer", "minimum": 0 },
    "master_reroll_max":     { "type": "integer", "minimum": 0 },
    "master_no_attack_tag_current": { "type": "integer", "minimum": 0 },
    "master_no_attack_tag_max":     { "type": "integer", "minimum": 0 },
    "master_full_balance_current": { "type": "integer", "minimum": 0 },
    "master_full_balance_max":     { "type": "integer", "minimum": 0 },

    "Lens": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name":  { "type": "string" },
        "desc":  { "type": "string" },
        "current": { "type": "integer", "minimum": 0, "default": 0 },
        "max":     { "type": "integer", "minimum": 0, "default": 0 },
        "show_on_panel": { "type": "boolean", "default": false }
      }
    },


    "base": { "$ref": "#/$defs/Base" },
    "base_invested": { "type": "integer", "minimum": 0 },

    "comfort":   { "$ref": "#/$defs/CurrentMax" },
    "attention": { "$ref": "#/$defs/CurrentMax" },

    "pain_threshold_bonus": { "type": "integer" },
    "pain_extra":       { "type": "integer" },
    "pain_extra_temp":  { "type": "integer" },
    "pain_max":         { "type": "integer", "minimum": 0 },
    "regen_modifier":   { "type": "string" },

    "balance_bonus":         { "type": "integer" },
    "balance_restore_bonus": { "type": "integer" },
    "spirit_bonus":          { "type": "integer" },
    "hp_bonus":              { "type": "integer" },

    "_hp_max_cap":          { "type": "integer", "minimum": 1, "description": "Вычисляемый потолок HP. Только чтение для ботов." },
    "_pain_threshold_data": { "$ref": "#/$defs/CurrentMax" },
    "_balance_data":        { "$ref": "#/$defs/CurrentMax" },
    "_spirit_data":         { "$ref": "#/$defs/CurrentMax" },
    "_mana_data":           { "$ref": "#/$defs/ManaData" },

    "settings": { "$ref": "#/$defs/Settings" },
    "notes":    { "type": "string" }
  },

  "$defs": {

    "CurrentMax": {
      "type": "object",
      "required": ["current","max"],
      "properties": {
        "current": { "type": "integer" },
        "max":     { "type": "integer", "minimum": 0 }
      }
    },

    "Mod": {
      "type": "object",
      "required": ["source","value"],
      "properties": {
        "source": { "type": "string" },
        "value":  { "type": "number" }
      }
    },

    "ClassDef": {
      "type": "object",
      "required": ["name","level"],
      "properties": {
        "name":        { "type": "string" },
        "level":       { "type": "integer", "minimum": 1 },
        "hp_die":      { "type": "integer", "minimum": 1 },
        "hp_rolls":    { "type": "array", "items": { "type": "integer" } },
        "abilities":   { "type": "array", "items": { "$ref": "#/$defs/AbilityDef" } },
        "has_spellbook": { "type": "boolean" },
        "spell_discount_extra": { "type": "integer" },
        "bab_type":    { "type": "string", "enum": ["poor","medium","good"] },
        "good_saves":  { "type": "array", "items": { "type": "string", "enum": ["fort","ref","will"] } }
      }
    },

    "RaceDef": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name":      { "type": "string" },
        "type":      { "type": "string" },
        "speed":     { "type": "integer" },
        "abilities": { "type": "array", "items": { "$ref": "#/$defs/AbilityDef" } }
      }
    },

    "AbilityDef": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name":  { "type": "string" },
        "desc":  { "type": "string" },
        "uses":  { "type": "boolean" },
        "uses_current": { "type": "integer", "minimum": 0 },
        "uses_max":     { "type": "integer", "minimum": 0 },
        "show_on_panel": { "type": "boolean", "default": true },
        "tick_mode":    { "type": "string", "enum": ["none","restore","spend","initiative"] },
        "cooldown_rounds":  { "type": "integer", "minimum": 0 },
        "cooldown_current": { "type": "integer", "minimum": 0 },
        "tick_on_initiative": { "type": "boolean", "default": true },
        "charges_tick_mode": {
          "type": "string",
          "enum": ["none", "decrement", "increment"],
          "default": "none"
        },
        "is_buff":       { "type": "boolean", "default": true,
          "description": "T48: способность — это баф/дебаф (шаблон = situational_bonuses)." },
        "source": { "type": "string", "enum": ["training","loot","race","class","quirk"],
          "default": "race",
          "description": "T-RACE: откуда способность. 'race'/'class' = бесплатная, 'training' = куплена за тренировки." },
        "invested": { "type": "integer", "minimum": 0, "default": 0,
          "description": "T-RACE: сколько тренировок вложено (0 = бесплатная). >0 → в UI метка «куплено (N)»." },
        "duration_rounds":  { "type": "integer", "minimum": 0 },
        "duration_current": { "type": "integer", "minimum": 0 },
        "charges_max":      { "type": "integer", "minimum": 0 },
        "charges_current":  { "type": "integer", "minimum": 0 },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/Effect" }
        },
        "on_activate_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/Effect" },
          "description": "T48: разовые эффекты при активации бафа-способности."
        },
        "permanent":    { "type": "boolean", "default": true },
        "keep_at_zero": { "type": "boolean", "default": true },
        "allow_toggle": { "type": "boolean", "default": true },
        "enabled":      { "type": "boolean", "default": true },
        "blocks":       {
          "type": "array",
          "items": { "type": "string" },
          "description": "T-BLOCKS-EXPANDED: список имён блокируемых функций (реестр BLOCKABLE в character.py). См. situational_bonuses.blocks."
        },
        "is_stance":    { "type": "boolean", "default": true }
      }
    },

    "Combat": {
      "type": "object",
      "properties": {
        "hp_current": { "type": "integer" },
        "hp_bought":  { "type": "integer" },
        "hp_temp":    { "type": "integer", "minimum": 0 },
        "ac":         { "type": "integer" },
        "initiative": { "type": "integer" },
        "speed":      { "type": "integer" },
        "bab":        { "type": "integer" },
        "cmb":        { "type": "integer" },
        "cmd":        { "type": "integer" },
        "size":       { "type": "string", "enum": ["Fine","Diminutive","Tiny","Small","Medium","Large","Huge","Gargantuan","Colossal"] },
        "saves": {
          "type": "object",
          "properties": {
            "fort": { "$ref": "#/$defs/Save" },
            "ref":  { "$ref": "#/$defs/Save" },
            "will": { "$ref": "#/$defs/Save" }
          }
        }
      }
    },

    "Save": {
      "type": "object",
      "properties": {
        "base": { "type": "integer" },
        "mods": { "type": "array", "items": { "$ref": "#/$defs/Mod" } }
      }
    },

    "Equipment": {
      "type": "object",
      "properties": {
        "armor_ac":  { "type": "integer" },
        "shield_ac": { "type": "integer" },
        "add_shield_ac_to_balance": { "type": "boolean" }
      }
    },

    "Item": {
      "type": "object",
      "required": ["id","name","category","location"],
      "properties": {
        "id":   { "type": "string", "description": "UUID. Должен совпадать с ключом в items{}." },
        "name": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["armor","shield","weapon","belt","body","chest","eyes","gloves","head","neck","ring","back","shoulders","legs","feet","companion","pet","modifier","tools_craft","tools_travel","components","holy_symbol","unload","consumable","misc"]
        },
        "location": { "type": "string", "enum": ["equipped","unload","bag","base"] },
        "slot": {
          "type": ["string","null"],
          "enum": ["armor","belt","body","chest","eyes","gloves","head","neck","ring1","ring2","back","shoulders","legs","feet","weapon_main","weapon_off","shield","companion","pet","modifier","tools_craft","tools_travel","components","holy_symbol","unload",null]
        },
        "order":    { "type": "integer" },
        "qty":      { "type": "integer", "minimum": 0 },
        "desc":     { "type": "string" },
        "icon_b64": { "type": "string" },
        "weight":      { "type": "number", "minimum": 0 },
        "weight_type": { "type": "string" },
        "price":       { "type": "integer", "minimum": 0 },
        "pack":        { "type": "string", "description": "T-CAT: имя файла-источника (без .json). Ставится load_catalogs для элементов из каталога." },
        "armor_type":   { "type": ["string","null"], "enum": ["Light","Medium","Heavy",null] },
        "ac_bonus":     { "type": "integer" },
        "ac_type":      { "type": "string", "enum": ["armor","shield","natural","deflection","misc"] },
        "ac_max_dex":   { "type": ["integer","null"] },
        "speed_penalty":{ "type": "integer" },
        "skill_penalty":{ "type": "integer" },
        "arcane_failure": { "type": "integer" },
        "mana_penalty":   { "type": "integer" },
        "unprof_penalty": { "type": "integer" },

        "damage":        { "type": "string", "description": "КАНОН для оружия (как в инвентаре). Пример: '6d6', 'd3+5'." },
        "damage_sml":    { "type": "string", "description": "LEGACY/резерв. Пусто в текущих сейвах. Не канон." },
        "damage_med":    { "type": "string", "description": "LEGACY/резерв." },
        "damage_type":   { "type": "string", "description": "LEGACY/резерв." },
        "hands":         { "type": "string", "description": "LEGACY/резерв." },

        "crit_threshold": { "type": "integer", "minimum": 1, "maximum": 20 },
        "crit_mult":      { "type": "integer", "minimum": 1 },
        "lucky_threshold": { "type": "integer", "minimum": 2, "maximum": 20, "description": "Порог счастливой атаки. По умолчанию 20." },
        "weapon_group":   { "type": "string" },
        "attack_bonus":   { "type": "integer" },
        "damage_bonus":   { "type": "integer" },

        "finesse":     { "type": "boolean" },
        "two_handed":  { "type": "boolean" },
        "ranged":      { "type": "boolean" },
        "thrown":      { "type": "boolean" },
        "range_ft":    { "type": "integer", "minimum": 0 },
        "required_level": { "type": "integer", "minimum": 0 },

        "uses":         { "type": "boolean" },
        "uses_max":     { "type": "integer", "minimum": 0 },
        "uses_current": { "type": "integer", "minimum": 0 },
        "show_on_panel":{ "type": "boolean" },

        "hp":     { "type": "integer", "minimum": 0 },
        "max_hp": { "type": "integer", "minimum": 0 },
        "hardness": { "type": "integer", "minimum": 0 },

        "passive_bonuses": { "type": "array", "items": { "$ref": "#/$defs/Mod" } },
        "activatable":  { "type": "boolean" },
        "activation_cost_spirit": { "type": "integer" },
        "activation_effects": { "type": "array", "items": { "$ref": "#/$defs/Effect" } },
        "activation_duration": { "type": "integer", "minimum": 0 },
        "activated":    { "type": "boolean" },

        "base_slots":   { "type": "integer", "minimum": 0 },
        "gray":         { "type": "boolean" },
        "enchants":     { "type": "array", "items": { "type": "object" } },
        "unload_bonus": { "type": "integer" },

        "tick_mode":       { "type": "string", "enum": ["none","restore","spend","initiative"] },
        "cooldown_rounds": { "type": "integer", "minimum": 0 },
        "cooldown_current":{ "type": "integer", "minimum": 0 },
        "tick_on_initiative": { "type": "boolean" }
      }
    },

    "Effect": {
      "type": "object",
      "required": ["target","value"],
      "properties": {
        "target": { "type": "string", "description": "str|dex|con|int|wis|cha|will|attack|damage|ac|ref|fort|cmd|cmb|initiative|speed|skill|lucky|hp_temp|restore_hp|restore_mana|restore_spirit|restore_balance|restore_resource|self_damage_per_tick (см. GLOSSARY §11). speed_mult — [DEPRECATED], код не применяет (T-REMOVE-SPEED-MULT)." },
