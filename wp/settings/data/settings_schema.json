  {"id": "backups_count", "domain": "app", "type": "int", "default": 5, "min": 0, "max": 100, "group": "saving"},
  {"id": "backups_folder", "domain": "app", "type": "folder_name", "default": "backups", "group": "saving"},
  {"id": "confirmations", "domain": "app", "type": "map", "value": "bool", "default": {"remove_item": true, "long_rest_end_combat": true, "catalog_remove_entry": true, "image_remove": true, "profile_delete": true}, "group": "safety"},
  {"id": "hotkeys", "domain": "app", "type": "map", "value": "hotkey", "default": {"toggle_mode": "Ctrl+Shift+W"}, "group": "hotkeys"},
  {"id": "notifications", "domain": "app", "type": "map", "value": "bool", "default": {}, "group": "notifications"},
  {"id": "log_kinds", "domain": "app", "type": "list", "item": "string", "default": [], "group": "log"},
  {"id": "log_max", "domain": "app", "type": "int", "default": 0, "min": 0, "max": 100000, "group": "log"},
  {"id": "resource_display", "domain": "app", "type": "map", "value": "enum", "allowed": ["number", "bar", "both", "percent", "flask"], "default": {"hp": "both", "balance": "both", "bp": "number", "spirit": "number", "mana": "bar", "comfort": "number"}, "group": "display"},
  {"id": "resource_segments", "domain": "app", "type": "map", "value": "int", "default": {"hp": 10, "balance": 5, "spirit": 5, "mana": 5, "pool": 5, "bp": 0, "comfort": 0}, "group": "display"},
  {"id": "window_classic", "domain": "app", "type": "rect", "default": [100, 100, 1280, 800], "group": "windows"},
  {"id": "window_lite", "domain": "app", "type": "rect", "default": [0, 0, 400, 300], "group": "windows"},
  {"id": "image_max_kb", "domain": "app", "type": "int", "default": 2048, "min": 1, "max": 102400, "group": "images"},
  {"id": "image_extensions", "domain": "app", "type": "list", "item": "string", "default": ["png", "jpg", "jpeg", "gif", "svg", "webp"], "group": "images"},
  {"id": "char_portrait", "domain": "character", "type": "string", "default": "", "group": "character"},
  {"id": "ignore_pain", "domain": "rules", "type": "bool", "default": false, "group": "rules"},
  {"id": "ignore_negative_morale", "domain": "rules", "type": "bool", "default": false, "group": "rules"},
  {"id": "speed_multiplier", "domain": "rules", "type": "float", "default": 1, "min": 0, "group": "rules"},
  {"id": "rest_regen_multiplier", "domain": "rules", "type": "float", "default": 1, "min": 0, "group": "rules"},
  {"id": "rest_regen_bonus", "domain": "rules", "type": "int", "default": 0, "group": "rules"},
  {"id": "hp_regen_per_tick", "domain": "rules", "type": "int", "default": 0, "group": "rules"},
  {"id": "overload_enabled", "domain": "rules", "type": "bool", "default": true, "group": "rules"},
  {"id": "log_limit", "domain": "rules", "type": "int", "default": 0, "min": 0, "group": "rules"},
  {"id": "iterative_step", "domain": "rules", "type": "int", "default": -5, "max": 0, "group": "rules"},
  {"id": "ranged_attack_stat", "domain": "rules", "type": "enum", "default": "dex", "allowed": ["str", "dex", "con", "int", "wis", "cha"], "group": "rules"},
  {"id": "ranged_damage_stat", "domain": "rules", "type": "enum", "default": "none", "allowed": ["none", "str", "dex", "con", "int", "wis", "cha"], "group": "rules"},
  {"id": "ranged_damage_mult", "domain": "rules", "type": "float", "default": 1, "min": 0, "group": "rules"},
  {"id": "thrown_attack_stat", "domain": "rules", "type": "enum", "default": "dex", "allowed": ["str", "dex", "con", "int", "wis", "cha"], "group": "rules"},
  {"id": "thrown_damage_stat", "domain": "rules", "type": "enum", "default": "str", "allowed": ["none", "str", "dex", "con", "int", "wis", "cha"], "group": "rules"},
  {"id": "thrown_damage_mult", "domain": "rules", "type": "float", "default": 1, "min": 0, "group": "rules"},
  {"id": "damage_order", "domain": "rules", "type": "list", "item": "enum", "allowed": ["percent", "flat", "modifier"], "default": ["percent", "flat", "modifier"], "group": "rules"}
 ],
 "profile_fields": {
