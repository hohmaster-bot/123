  {"id": "last_character", "domain": "app", "type": "string", "default": "", "group": "general"},
  {"id": "ac_cell_primary", "domain": "app", "type": "string", "default": "melee", "group": "defense_display"},
  {"id": "ac_cell_secondary", "domain": "app", "type": "string", "default": "melee_parry", "group": "defense_display"},
