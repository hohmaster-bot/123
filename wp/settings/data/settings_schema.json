{
 "format": 1,
 "note": "Settings schema (package 19, D13, D22). Each key: id, domain (rules = Character.rules_settings, character = Character.char_settings, app = the global settings file), type (bool int float enum string color hotkey point rect list map), default, allowed / min / max, item (list items) or value (map values) type, group, label and description ids (i18n keys). Unknown keys in a file are kept, never interpreted.",
 "keys": [
  {"id": "language", "domain": "app", "type": "enum", "default": "ru", "allowed": ["ru", "en"], "group": "general"},
  {"id": "theme", "domain": "app", "type": "string", "default": "light", "group": "general"},
  {"id": "ui_scale", "domain": "app", "type": "float", "default": 1.0, "min": 0.5, "max": 3.0, "group": "general"},
