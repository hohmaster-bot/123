{
 "format": 1,
 "note": "QSS template (package 21): selector -> declarations; {token} = a flat theme token (colors by name; font_family, font_base, font_small, font_large; radius, spacing, border_width, overlay_opacity).",
 "rules": [
  {"selector": "QWidget", "declarations": [["background-color", "{background}"], ["color", "{text}"],
                                            ["font-family", "\"{font_family}\""], ["font-size", "{font_base}px"]]},
  {"selector": "QFrame#panel", "declarations": [["background-color", "{surface}"],
                                                 ["border", "{border_width}px solid {border}"], ["border-radius", "{radius}px"]]},
  {"selector": "QPushButton", "declarations": [["background-color", "{accent}"], ["color", "{accent_text}"],
                                                ["border-radius", "{radius}px"], ["padding", "{spacing}px"]]},
  {"selector": "QLabel#muted", "declarations": [["color", "{muted}"], ["font-size", "{font_small}px"]]},
  {"selector": "QLabel#title", "declarations": [["font-size", "{font_large}px"]]},
  {"selector": "QProgressBar#hp::chunk", "declarations": [["background-color", "{hp}"]]},
  {"selector": "QProgressBar#balance::chunk", "declarations": [["background-color", "{balance}"]]},
  {"selector": "QProgressBar#mana::chunk", "declarations": [["background-color", "{mana}"]]},
  {"selector": "QProgressBar#spirit::chunk", "declarations": [["background-color", "{spirit}"]]},
  {"selector": "QLabel#danger", "declarations": [["color", "{danger}"]]},
  {"selector": "QLabel#warning", "declarations": [["color", "{warning}"]]},
  {"selector": "QLabel#success", "declarations": [["color", "{success}"]]}
 ],
 "shell": {"note": "Package 32: the window shell. min_font_px = the smallest font at 100% (UI_WISHES Classic v2 point 11); scaled = the flat tokens multiplied by the scale; rules = added after the rules above by build_qss.",
  "min_font_px": 11, "scaled": ["font_base", "font_small", "font_large", "spacing"],
  "rules": [
  {"selector": "QMainWindow, QWidget#central", "declarations": [["background-color", "{background}"]]},
   {"selector": "QMenuBar", "declarations": [["background-color", "{surface}"], ["color", "{text}"]]},
   {"selector": "QMenuBar::item:selected", "declarations": [["background-color", "{accent}"], ["color", "{accent_text}"]]},
   {"selector": "QMenu", "declarations": [["background-color", "{surface}"], ["color", "{text}"], ["border", "{border_width}px solid {border}"]]},
   {"selector": "QMenu::item:selected", "declarations": [["background-color", "{accent}"], ["color", "{accent_text}"]]},
   {"selector": "QFrame#block", "declarations": [["background-color", "{surface}"], ["border", "{border_width}px solid {border}"], ["border-radius", "{radius}px"]]},
   {"selector": "QFrame#strip", "declarations": [["background-color", "{strip_background}"], ["border", "{border_width}px solid {border}"], ["border-radius", "{radius}px"]]},
   {"selector": "QFrame#block QLabel, QFrame#strip QLabel, QFrame#hint QLabel", "declarations": [["background-color", "transparent"]]},
   {"selector": "QLabel#block_title", "declarations": [["font-size", "{font_large}px"], ["font-weight", "bold"]]},
   {"selector": "QLabel#big", "declarations": [["font-size", "{font_large}px"], ["font-weight", "bold"]]},
   {"selector": "QLabel#portrait", "declarations": [["background-color", "{background}"], ["color", "{muted}"], ["border", "{border_width}px dashed {border}"], ["border-radius", "{radius}px"]]},
   {"selector": "QFrame#hint", "declarations": [["background-color", "{hint_background}"], ["border", "{border_width}px solid {accent}"], ["border-radius", "{radius}px"]]},
   {"selector": "QProgressBar#xp", "declarations": [["background-color", "{tube_empty}"], ["border", "{border_width}px solid {tube_glass}"], ["border-radius", "{radius}px"], ["color", "{text}"], ["text-align", "center"], ["font-size", "{font_small}px"]]},
   {"selector": "QProgressBar#xp::chunk", "declarations": [["background-color", "qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 {tube_highlight}, stop: 0.45 {accent}, stop: 1 {accent})"], ["border-radius", "{radius}px"]]},
   {"selector": "QLabel#value, QLabel#big, QLabel#over_max", "declarations": [["font-family", "\"{font_numbers}\""]]},
   {"selector": "QLabel#over_max", "declarations": [["color", "{warning}"], ["font-weight", "bold"]]},
   {"selector": "QFrame#block QLabel#chip", "declarations": [["background-color", "{overload_chip}"], ["color", "{chip_text}"], ["border-radius", "{radius}px"], ["padding", "0px 4px"], ["font-size", "{font_small}px"]]},
   {"selector": "QLabel#message", "declarations": [["color", "{muted}"], ["font-size", "{font_small}px"]]},
   {"selector": "QPushButton#small", "declarations": [["padding", "1px 6px"], ["font-size", "{font_small}px"]]},
   {"selector": "QScrollArea#compact_pools, QWidget#resources_inner", "declarations": [["background-color", "transparent"], ["border", "none"]]}
  ]}
}
